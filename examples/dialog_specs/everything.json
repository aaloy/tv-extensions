{
  "version": 1,
  "title": "Everything",
  "width": 76,
  "height": 26,
  "controls": [
    {"type": "label", "name": "name_label", "x": 2, "y": 1, "w": 8, "h": 1, "text": "~N~ame", "link": "name"},
    {"type": "input", "name": "name", "x": 11, "y": 1, "w": 30, "h": 1, "max_len": 40, "required": true, "validator": {"type": "filter", "chars": "abcdefghijklmnopqrstuvwxyz "}, "history": 3},
    {"type": "static_text", "x": 2, "y": 2, "w": 30, "h": 1, "text": "Fill in the form", "centered": true},
    {"type": "memo", "name": "notes", "x": 2, "y": 3, "w": 30, "h": 3, "text": "a\nb"},
    {"type": "check_box", "name": "vip", "x": 2, "y": 6, "w": 20, "h": 1, "text": "~V~IP", "checked": true},
    {"type": "check_boxes", "name": "extras", "x": 2, "y": 7, "w": 20, "h": 2, "items": ["Wi-Fi", "Parking"], "checked": [1]},
    {"type": "radio_buttons", "name": "kind", "x": 24, "y": 7, "w": 20, "h": 2, "items": ["Retail", "Wholesale"], "selected": 1, "on_change": "kind_changed"},
    {"type": "combo_box", "name": "country", "x": 2, "y": 9, "w": 20, "h": 1, "items": ["Spain", "Italy"], "selected": 0},
    {"type": "list_box", "name": "tags", "x": 50, "y": 1, "w": 22, "h": 4, "items": ["red", "green"], "multi": true},
    {"type": "spinner", "name": "age", "x": 24, "y": 9, "w": 10, "h": 1, "min": 0, "max": 120, "value": 30},
    {"type": "slider", "name": "volume", "x": 36, "y": 9, "w": 12, "h": 1, "min": 0, "max": 10, "value": 5},
    {"type": "progress_bar", "name": "progress", "x": 2, "y": 10, "w": 30, "h": 1, "max": 100, "value": 40},
    {"type": "table", "name": "orders", "x": 50, "y": 5, "w": 22, "h": 5, "columns": [{"title": "Item", "width": 10}, {"title": "Qty", "width": 5, "align": "right"}], "rows": [["Pen", "2"]]},
    {"type": "line", "x": 2, "y": 11, "w": 70, "h": 1},
    {"type": "line", "x": 38, "y": 13, "w": 1, "h": 7, "style": "double"},
    {"type": "group_box", "x": 1, "y": 12, "w": 72, "h": 9, "title": "More"},
    {"type": "tabs", "name": "pages", "x": 2, "y": 13, "w": 36, "h": 7, "pages": [
      {"title": "~O~ne", "controls": [
        {"type": "input", "name": "city", "x": 1, "y": 0, "w": 20, "h": 1, "validator": {"type": "picture", "mask": "@@@@@@"}}
      ] },
      {"title": "~T~wo", "controls": [] }
    ] },
    {"type": "auto_complete", "name": "fruit", "x": 40, "y": 13, "w": 20, "h": 1, "items": ["Apple", "Banana"], "require_match": true},
    {"type": "dual_list", "name": "team", "x": 40, "y": 14, "w": 32, "h": 6, "items": ["ann", {"key": "bob", "label": "Bob B."}], "chosen": ["bob"]},
    {"type": "error_line", "x": 2, "y": 21, "w": 60, "h": 1},
    {"type": "button", "x": 20, "y": 22, "w": 10, "h": 2, "text": "~O~K", "command": "ok", "default": true},
    {"type": "button", "x": 32, "y": 22, "w": 12, "h": 2, "text": "~L~ookup", "command": "lookup"}
  ]
}
