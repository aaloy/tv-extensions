    { "type": "label", "x": 2, "y": 9, "w": 10, "h": 1, "text": "K~i~nd", "link": "kind" },
    { "type": "radio_buttons", "name": "kind", "x": 13, "y": 9, "w": 24, "h": 2, "items": ["Pe~r~sonal", "~B~usiness"] },
    { "type": "label", "x": 2, "y": 12, "w": 10, "h": 1, "text": "No~t~es", "link": "notes" },
    { "type": "memo", "name": "notes", "x": 13, "y": 12, "w": 38, "h": 3 },
    { "type": "error_line", "x": 2, "y": 15, "w": 50, "h": 1 },
    { "type": "button", "x": 13, "y": 16, "w": 10, "h": 2, "text": "~O~K", "default": true },
    { "type": "button", "x": 24, "y": 16, "w": 12, "h": 2, "text": "Cancel", "command": "cancel" }
  ]
