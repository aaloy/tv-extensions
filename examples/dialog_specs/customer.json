{
  "version": 1,
  "title": "Customer",
  "width": 52,
  "height": 16,
  "controls": [
    { "type": "label", "x": 2, "y": 1, "w": 8, "h": 1, "text": "~N~ame", "link": "name" },
    { "type": "input", "name": "name", "x": 11, "y": 1, "w": 36, "h": 1, "max_len": 60, "required": true },
    { "type": "label", "x": 2, "y": 3, "w": 8, "h": 1, "text": "~E~mail", "link": "email" },
    { "type": "input", "name": "email", "x": 11, "y": 3, "w": 36, "h": 1, "max_len": 80, "hint": "Where invoices are sent" },
    { "type": "label", "x": 2, "y": 5, "w": 8, "h": 1, "text": "~C~ountry", "link": "country" },
    { "type": "combo_box", "name": "country", "x": 11, "y": 5, "w": 20, "h": 1, "items": ["Spain", "Italy", "France"], "selected": 0 },
    { "type": "label", "x": 2, "y": 7, "w": 8, "h": 1, "text": "~K~ind", "link": "kind" },
    { "type": "radio_buttons", "name": "kind", "x": 11, "y": 7, "w": 18, "h": 2, "items": ["~R~etail", "~W~holesale"], "on_change": "kind_changed" },
    { "type": "check_box", "name": "vip", "x": 31, "y": 7, "w": 16, "h": 1, "text": "~V~IP customer" },
    { "type": "error_line", "x": 2, "y": 10, "w": 46, "h": 1 },
    { "type": "button", "x": 2, "y": 11, "w": 12, "h": 2, "text": "~L~ookup", "command": "lookup" },
    { "type": "button", "x": 24, "y": 11, "w": 11, "h": 2, "text": "~O~K", "default": true },
    { "type": "button", "x": 36, "y": 11, "w": 12, "h": 2, "text": "Cancel", "command": "cancel" }
  ]
}
