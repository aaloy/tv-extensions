    { "type": "label", "x": 2, "y": 3, "w": 10, "h": 1, "text": "~E~mail", "link": "email" },
    { "type": "input", "name": "email", "x": 13, "y": 3, "w": 38, "h": 1, "max_len": 80 },
    { "type": "label", "x": 2, "y": 5, "w": 10, "h": 1, "text": "Pho~n~e", "link": "phone" },
    { "type": "input", "name": "phone", "x": 13, "y": 5, "w": 20, "h": 1, "max_len": 20, "validator": { "type": "filter", "chars": "0123456789+-() " } },
    { "type": "label", "x": 2, "y": 7, "w": 10, "h": 1, "text": "~C~ountry", "link": "country" },
